# ---------------------------------------------------------------------------
# Competitive Intelligence Briefing Crew — environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# --- LLM Provider — OpenRouter (recommended, free tier available) ----------
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models on OpenRouter (confirmed free as of July 2026):
#   meta-llama/llama-3.3-70b-instruct:free       ← 131K ctx, best for drafting/writing
#   nvidia/nemotron-3-super-120b-a12b:free        ← 1M ctx, best for long agent tasks
#   qwen/qwen3-coder:free                         ← 1M ctx, strong reasoning
#   openai/gpt-oss-120b:free                      ← 131K ctx, general reasoning
#   google/gemma-4-27b-it:free                    ← 131K ctx, general instruction
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- LLM Provider — OpenAI (alternative, comment out OpenRouter above) -----
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Web Search Provider (choose one) --------------------------------------
TAVILY_API_KEY=tvly-your-key-here
# SERPER_API_KEY=your-serper-key-here

# --- Execution Limits (Supervisor enforced) --------------------------------
MAX_SOURCES=15
MAX_STEPS=20
MAX_RETRIES_PER_TOOL_CALL=2
SEARCH_TIMEOUT_SECONDS=12

# --- App -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
